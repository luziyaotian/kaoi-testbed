<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dt_teleop_testbed</name>
  <version>0.1.0</version>
  <description>
    Digital-twin teleoperation testbed for studying network-induced
    synchronisation degradation (Age of Information, pose sync error) on a
    UFactory Lite 6. Contains the headless twin, network impairment node,
    twin-to-robot bridge, and AoI/sync logger.
  </description>
  <maintainer email="you@example.com">you</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>trajectory_msgs</depend>

  <!-- xarm_msgs is used by later nodes (bridge to real Lite 6). -->
  <exec_depend>xarm_msgs</exec_depend>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
